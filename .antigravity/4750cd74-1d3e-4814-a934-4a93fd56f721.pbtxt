        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "// Explications p\303\251dagogiques et bonnes pratiques pour enrichir la fiche"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export const CARD_EXPLANATIONS: Record<number, { explanation: string; tip: string }> = {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  1: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \"input() retourne toujours une cha\303\256ne de caract\303\250res (str). Il faut explicitement convertir avec int() ou float() pour les calculs num\303\251riques.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tip: \"Astuce : print() accepte sep=\\\"\\\" et end=\\\"\\\" pour contr\303\264ler les s\303\251parateurs et le saut de ligne.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  2: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \"L\'indentation (g\303\251n\303\251ralement 4 espaces) d\303\251finit les blocs de code en Python. range(debut, fin, pas) exclut la valeur finale.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tip: \"Astuce : range(1, 10, 2) g\303\251n\303\250re [1, 3, 5, 7, 9].\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  3: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \"Python est \303\240 typage dynamique fort : les types ne sont pas implicitement convertis lors d\'op\303\251rations incompatibles.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tip: \"Astuce : bool(\'\') ou bool(0) valent False (valeurs Falsy).\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  4: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \"Les tuples sont immuables (prot\303\251g\303\251s contre les modifications accidentelles) et peuvent servir de cl\303\251s de dictionnaires contrairement aux listes.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tip: \"Astuce : Pour un tuple \303\240 un seul \303\251l\303\251ment, ajoutez une virgule : t = (42,).\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  5: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \"Le d\303\251coupage (slicing) [debut:fin:pas] permet d\'extraire des sous-listes sans modifier la liste originale. L[::-1] renvoie une copie invers\303\251e.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tip: \"Astuce : L.append(x) modifie la liste en place et renvoie None.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  6: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \"Les dictionnaires associent des cl\303\251s uniques \303\240 des valeurs. La recherche par cl\303\251 est en temps constant O(1).\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tip: \"Astuce : Utilisez d.get(\'cle\', valeur_par_defaut) pour \303\251viter un KeyError.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  7: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \"Les annotations de type (type hints) aident les IDEs et mypy sans affecter l\'ex\303\251cution runtime. Les lambdas sont des fonctions anonymes d\'une seule expression.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tip: \"Astuce : Privil\303\251giez \'def\' plut\303\264t qu\'une lambda assign\303\251e \303\240 une variable pour la clart\303\251.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  8: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \"Fonctions d\'ordre sup\303\251rieur du paradigme fonctionnel. map et filter renvoient des it\303\251rateurs, n\303\251cessitant list() pour \303\252tre mat\303\251rialis\303\251s.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tip: \"Astuce : Les list comprehensions [x*x for x in L] sont souvent pr\303\251f\303\251r\303\251es en Python moderne.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  9: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \"self repr\303\251sente l\'instance courante de la classe. __init__ est la m\303\251thode sp\303\251ciale appel\303\251e lors de l\'instanciation.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tip: \"Astuce : Toutes les m\303\251thodes d\'instance doivent d\303\251clarer \'self\' comme premier argument.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  10: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \"try / except permet de g\303\251rer les erreurs proprement. Le bloc \'finally\' est toujours ex\303\251cut\303\251, m\303\252me en cas d\'exception non intercept\303\251e.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tip: \"Astuce : \303\211vitez le \'except:\' nu, sp\303\251cifiez toujours le type d\'exception attendu.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  11: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \"__name__ == \'__main__\' permet d\'ex\303\251cuter du code uniquement lorsque le script est lanc\303\251 directement, et non lorsqu\'il est import\303\251.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tip: \"Astuce : Indispensable pour cr\303\251er des scripts r\303\251utilisables sous forme de modules.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  12: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \"Le module os interagit avec le syst\303\250me d\'exploitation et les chemins de fichiers. Shutil g\303\250re les op\303\251rations de haut niveau comme la copie de fichiers.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tip: \"Astuce : En Python moderne (>=3.4), le module pathlib.Path est souvent une excellente alternative.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  13: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \"Le gestionnaire de contexte \'with\' garantit la fermeture automatique du fichier, m\303\252me si une exception survient pendant la lecture/\303\251criture.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tip: \"Astuce : Pr\303\251cisez encoding=\\\"utf-8\\\" lors de l\'ouverture pour \303\251viter les probl\303\250mes d\'encodage sous Windows.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  14: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \"NumPy vectorise les calculs math\303\251matiques pour des performances C ultra-rapides sur des tableaux \303\240 N dimensions.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tip: \"Astuce : Les op\303\251rations arithm\303\251tiques (+, *, etc.) s\'appliquent \303\251l\303\251ment par \303\251l\303\251ment.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  15: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \"Pandas est l\'outil standard pour la manipulation tabulaire en Data Science. loc[] filtre par label et index, iloc[] par position num\303\251rique.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tip: \"Astuce : Utilisez df.head() et df.info() pour inspecter rapidement un jeu de donn\303\251es.\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  16: {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \"Matplotlib est la biblioth\303\250que fondamentale de visualisation en Python. Chaque fonction configure la figure courante avant plt.show().\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tip: \"Astuce : Enregistrez votre graphique avec plt.savefig(\'graph.png\', dpi=300).\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "};"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
    overwrite: true
  }
}
