      replacement_content: "export type QuizLevel = \'debutant\' | \'intermediaire\' | \'avance\' | \'tous\';\n\nexport interface QuizQuestion {\n  id: number;\n  level: \'debutant\' | \'intermediaire\' | \'avance\';\n  category: string;\n  relatedCardId: number;\n  question: string;\n  code?: string;\n  options: string[];\n  correctIndex: number;\n  explanation: string;\n}\n\nexport const QUIZ_QUESTIONS: QuizQuestion[] = [\n  // ==========================================\n  // --- NIVEAU D\303\211BUTANT (20 QUESTIONS) ---\n  // ==========================================\n  {\n    id: 1,\n    level: \'debutant\',\n    category: \'Bases\',\n    relatedCardId: 1,\n    question: \"Que retourne la fonction input() par d\303\251faut en Python ?\",\n    code: \"x = input(\\\"Entrez un nombre : \\\")\",\n    options: [\n      \"Un entier (int)\",\n      \"Une cha\303\256ne de caract\303\250res (str)\",\n      \"Un flottant (float)\",\n      \"Le type correspondant \303\240 la saisie\"\n    ],\n    correctIndex: 1,\n    explanation: \"input() retourne TOUJOURS une cha\303\256ne de caract\303\250res (str). Il faut explicitement convertir avec int(x) ou float(x) pour effectuer des calculs num\303\251riques.\"\n  },\n  {\n    id: 2,\n    level: \'debutant\',\n    category: \'Bases\',\n    relatedCardId: 2,\n    question: \"Qu\'affiche ce code avec la fonction range() ?\",\n    code: \"for i in range(1, 6, 2):\\n    print(i, end=\\\" \\\")\",\n    options: [\n      \"1 2 3 4 5\",\n      \"1 3 5\",\n      \"1 3 5 7\",\n      \"2 4 6\"\n    ],\n    correctIndex: 1,\n    explanation: \"range(debut, fin, pas) commence \303\240 1, s\'arr\303\252te strictement avant 6, avec un pas de 2. Les valeurs produites sont donc 1, 3 et 5.\"\n  },\n  {\n    id: 3,\n    level: \'debutant\',\n    category: \'Bases\',\n    relatedCardId: 3,\n    question: \"Quelle est la valeur de bool(\\\"\\\") en Python ?\",\n    options: [\n      \"True\",\n      \"False\",\n      \"None\",\n      \"Provoque une ValueError\"\n    ],\n    correctIndex: 1,\n    explanation: \"Une cha\303\256ne vide \\\"\\\" est consid\303\251r\303\251e comme falsy en Python. Sa conversion avec bool(\\\"\\\") renvoie donc False. Tout comme 0, [] ou {}.\"\n  },\n  {\n    id: 4,\n    level: \'debutant\',\n    category: \'Donn\303\251es\',\n    relatedCardId: 4,\n    question: \"Quelle est la principale diff\303\251rence entre un tuple et une liste ?\",\n    options: [\n      \"Les listes s\'\303\251crivent avec des parenth\303\250ses, les tuples avec des crochets\",\n      \"Les tuples sont immuables (non modifiables), les listes sont mutables\",\n      \"Les tuples ne peuvent contenir que des nombres\",\n      \"Les tuples sont toujours tri\303\251s par d\303\251faut\"\n    ],\n    correctIndex: 1,\n    explanation: \"Les tuples sont immuables : une fois cr\303\251\303\251s, on ne peut ni modifier ni ajouter d\'\303\251l\303\251ments. Les listes sont mutables.\"\n  },\n  {\n    id: 5,\n    level: \'debutant\',\n    category: \'Donn\303\251es\',\n    relatedCardId: 5,\n    question: \"Comment ajouter un \303\251l\303\251ment \303\240 la fin d\'une liste L en Python ?\",\n    options: [\n      \"L.add(x)\",\n      \"L.push(x)\",\n      \"L.append(x)\",\n      \"L.insertEnd(x)\"\n    ],\n    correctIndex: 2,\n    explanation: \"La m\303\251thode officielle pour ajouter un \303\251l\303\251ment \303\240 la fin d\'une liste Python est L.append(x). Elle modifie la liste en place.\"\n  },\n  {\n    id: 6,\n    level: \'debutant\',\n    category: \'Bases\',\n    relatedCardId: 1,\n    question: \"Comment afficher plusieurs variables s\303\251par\303\251es par un tiret avec print() ?\",\n    options: [\n      \"print(a, b, split=\\\"-\\\")\",\n      \"print(a, b, sep=\\\"-\\\")\",\n      \"print(a, b, join=\\\"-\\\")\",\n      \"print(a - b)\"\n    ],\n    correctIndex: 1,\n    explanation: \"Le param\303\250tre nomm\303\251 \'sep\' de print() d\303\251finit la cha\303\256ne s\303\251paratrice entre chaque argument affich\303\251 (par d\303\251faut un espace simple).\"\n  },\n  {\n    id: 7,\n    level: \'debutant\',\n    category: \'Donn\303\251es\',\n    relatedCardId: 5,\n    question: \"Quelle fonction native renvoie le nombre d\'\303\251l\303\251ments d\'une liste ou d\'une cha\303\256ne ?\",\n    code: \"L = [10, 20, 30]\\ntaille = ???(L)\",\n    options: [\n      \"size(L)\",\n      \"length(L)\",\n      \"len(L)\",\n      \"count(L)\"\n    ],\n    correctIndex: 2,\n    explanation: \"La fonction globale len(objet) retourne la longueur (nombre d\'\303\251l\303\251ments) d\'une s\303\251quence comme une liste, un tuple ou une cha\303\256ne.\"\n  },\n  {\n    id: 8,\n    level: \'debutant\',\n    category: \'Donn\303\251es\',\n    relatedCardId: 5,\n    question: \"Comment acc\303\251der au dernier \303\251l\303\251ment d\'une liste sans conna\303\256tre sa taille ?\",\n    code: \"L = [4, 8, 15, 16, 23, 42]\",\n    options: [\n      \"L[last]\",\n      \"L[-1]\",\n      \"L[end]\",\n      \"L.pop()\"\n    ],\n    correctIndex: 1,\n    explanation: \"L\'indexation n\303\251gative commence \303\240 -1 pour le dernier \303\251l\303\251ment, -2 pour l\'avant-dernier, etc.\"\n  },\n  {\n    id: 9,\n    level: \'debutant\',\n    category: \'Bases\',\n    relatedCardId: 3,\n    question: \"Que produit l\'expression int(3.9) en Python ?\",\n    options: [\n      \"4 (arrondi au plus proche)\",\n      \"3 (troncature de la partie d\303\251cimale)\",\n      \"Une erreur TypeError\",\n      \"3.0\"\n    ],\n    correctIndex: 1,\n    explanation: \"La conversion int() sur un float tronque toujours vers z\303\251ro la partie d\303\251cimale, sans arrondir. int(3.9) donne 3.\"\n  },\n  {\n    id: 10,\n    level: \'debutant\',\n    category: \'Donn\303\251es\',\n    relatedCardId: 4,\n    question: \"Qu\'affiche le d\303\251paquetage suivant ?\",\n    code: \"t = (10, 20)\\na, b = t\\nprint(b)\",\n    options: [\n      \"(10, 20)\",\n      \"10\",\n      \"20\",\n      \"Une erreur ValueError\"\n    ],\n    correctIndex: 2,\n    explanation: \"Le d\303\251paquetage assigne respectivement le premier \303\251l\303\251ment \303\240 \'a\' (10) et le deuxi\303\250me \303\240 \'b\' (20).\"\n  },\n  {\n    id: 11,\n    level: \'debutant\',\n    category: \'Bases\',\n    relatedCardId: 2,\n    question: \"Quel mot-cl\303\251 est utilis\303\251 pour une condition alternative en Python ?\",\n    options: [\n      \"else if\",\n      \"elsif\",\n      \"elif\",\n      \"case\"\n    ],\n    correctIndex: 2,\n    explanation: \"En Python, la contraction de \'else if\' est \'elif\'.\"\n  },\n  {\n    id: 12,\n    level: \'debutant\',\n    category: \'Bases\',\n    relatedCardId: 3,\n    question: \"Quel est le r\303\251sultat de l\'op\303\251ration \'3\' + \'5\' ?\",\n    options: [\n      \"8\",\n      \"\'35\'\",\n      \"\'8\'\",\n      \"Une erreur TypeError\"\n    ],\n    correctIndex: 1,\n    explanation: \"Comme ce sont deux cha\303\256nes de caract\303\250res (str), l\'op\303\251rateur \'+\' effectue une concat\303\251nation, produisant \'35\'.\"\n  },\n  {\n    id: 13,\n    level: \'debutant\',\n    category: \'Donn\303\251es\',\n    relatedCardId: 5,\n    question: \"Quelle m\303\251thode permet de supprimer un \303\251l\303\251ment par sa valeur dans une liste ?\",\n    code: \"L = [10, 20, 30]\\n# Retirer la valeur 20\",\n    options: [\n      \"L.remove(20)\",\n      \"del L(20)\",\n      \"L.delete(20)\",\n      \"L.drop(20)\"\n    ],\n    correctIndex: 0,\n    explanation: \"L.remove(valeur) supprime la premi\303\250re occurrence de la valeur dans la liste. del L[index] supprime par index.\"\n  },\n  {\n    id: 14,\n    level: \'debutant\',\n    category: \'Bases\',\n    relatedCardId: 2,\n    question: \"Comment it\303\251rer directement sur les \303\251l\303\251ments d\'une liste sans utiliser range() ?\",\n    options: [\n      \"for element in sequence:\",\n      \"foreach (element in sequence):\",\n      \"for (i = 0; i < len; i++):\",\n      \"loop element sequence:\"\n    ],\n    correctIndex: 0,\n    explanation: \"En Python, la boucle for it\303\250re directement sur chaque \303\251l\303\251ment de n\'importe quel it\303\251rable via \'for element in sequence:\'.\"\n  },\n  {\n    id: 15,\n    level: \'debutant\',\n    category: \'Bases\',\n    relatedCardId: 1,\n    question: \"Quel symbole d\303\251bute un commentaire sur une ligne en Python ?\",\n    options: [\n      \"//\",\n      \"/*\",\n      \"#\",\n      \"--\"\n    ],\n    correctIndex: 2,\n    explanation: \"Le symbole di\303\250se \'#\' est utilis\303\251 pour les commentaires d\'une ligne en Python.\"\n  },\n  {\n    id: 16,\n    level: \'debutant\',\n    category: \'Donn\303\251es\',\n    relatedCardId: 6,\n    question: \"Quelle est la syntaxe correcte pour cr\303\251er un dictionnaire vide ?\",\n    options: [\n      \"d = []\",\n      \"d = ()\",\n      \"d = {}\",\n      \"d = dict[]\"\n    ],\n    correctIndex: 2,\n    explanation: \"Les accolades \'{}\' ou \'dict()\' cr\303\251ent un dictionnaire vide. Les crochets \'[]\' cr\303\251ent une liste et \'()\' un tuple.\"\n  },\n  {\n    id: 17,\n    level: \'debutant\',\n    category: \'Bases\',\n    relatedCardId: 2,\n    question: \"Que se passe-t-il si la condition d\'une boucle while reste toujours True ?\",\n    options: [\n      \"La boucle s\'arr\303\252te apr\303\250s 100 it\303\251rations par s\303\251curit\303\251\",\n      \"Une boucle infinie est cr\303\251\303\251e\",\n      \"Python l\303\250ve une RecursionError\",\n      \"Le programme s\'interrompt avec un avertissement SyntaxWarning\"\n    ],\n    correctIndex: 1,\n    explanation: \"Si la condition ne devient jamais False et qu\'aucun break n\'est rencontr\303\251, la boucle tourne ind\303\251finiment (boucle infinie).\"\n  },\n  {\n    id: 18,\n    level: \'debutant\',\n    category: \'Donn\303\251es\',\n    relatedCardId: 5,\n    question: \"Quel est le r\303\251sultat du slicing L[0:2] sur L = [\'a\', \'b\', \'c\', \'d\'] ?\",\n    options: [\n      \"[\'a\', \'b\']\",\n      \"[\'a\', \'b\', \'c\']\",\n      \"[\'b\', \'c\']\",\n      \"[\'a\']\"\n    ],\n    correctIndex: 0,\n    explanation: \"L[0:2] prend l\'indice 0 (\'a\') et l\'indice 1 (\'b\'). L\'indice 2 est strictement exclu.\"\n  },\n  {\n    id: 19,\n    level: \'debutant\',\n    category: \'Bases\',\n    relatedCardId: 3,\n    question: \"Quelle fonction permet de conna\303\256tre le type d\'une variable ?\",\n    options: [\n      \"typeof(x)\",\n      \"type(x)\",\n      \"var_type(x)\",\n      \"is(x)\"\n    ],\n    correctIndex: 1,\n    explanation: \"La fonction int\303\251gr\303\251e type(x) renvoie le type dynamique de l\'objet (ex: <class \'int\'>).\"\n  },\n  {\n    id: 20,\n    level: \'debutant\',\n    category: \'Bases\',\n    relatedCardId: 1,\n    question: \"Par d\303\251faut, par quoi se termine chaque appel \303\240 print() si \'end\' n\'est pas sp\303\251cifi\303\251 ?\",\n    options: [\n      \"Un espace \' \'\",\n      \"Un retour \303\240 la ligne \'\\\\n\'\",\n      \"Une tabulation \'\\\\t\'\",\n      \"Rien du tout (cha\303\256ne vide)\"\n    ],\n    correctIndex: 1,\n    explanation: \"Par d\303\251faut, print() a pour param\303\250tre end=\'\\\\n\', ce qui provoque un saut de ligne automatique.\"\n  },\n\n  // ==========================================\n  // --- NIVEAU INTERM\303\211DIAIRE (20 QUESTIONS) ---\n  // ==========================================\n  {\n    id: 21,\n    level: \'intermediaire\',\n    category: \'Donn\303\251es\',\n    relatedCardId: 6,\n    question: \"Comment acc\303\251der en toute s\303\251curit\303\251 \303\240 une cl\303\251 de dictionnaire avec une valeur de repli ?\",\n    code: \"d = {\'a\': 1}\\nval = d.???(\'b\', 0)\",\n    options: [\n      \"find(\'b\', 0)\",\n      \"get(\'b\', 0)\",\n      \"fetch(\'b\', 0)\",\n      \"lookup(\'b\', 0)\"\n    ],\n    correctIndex: 1,\n    explanation: \"d.get(cle, defaut) renvoie la valeur associ\303\251e \303\240 la cl\303\251 si elle existe, ou la valeur de repli sans lever d\'exception KeyError.\"\n  },\n  {\n    id: 22,\n    level: \'intermediaire\',\n    category: \'Donn\303\251es\',\n    relatedCardId: 5,\n    question: \"Que renvoie l\'instruction L[::-1] sur une liste L = [1, 2, 3] ?\",\n    code: \"L = [1, 2, 3]\\nprint(L[::-1])\",\n    options: [\n      \"[-1, -2, -3]\",\n      \"[3, 2, 1]\",\n      \"[1, 2]\",\n      \"Une erreur SyntaxError\"\n    ],\n    correctIndex: 1,\n    explanation: \"Le slicing [::-1] avec un pas n\303\251gatif de -1 effectue une inversion compl\303\250te de la liste ou de la cha\303\256ne sans modifier l\'original.\"\n  },\n  {\n    id: 23,\n    level: \'intermediaire\',\n    category: \'Fonctions\',\n    relatedCardId: 7,\n    question: \"Qu\'est-ce qu\'une fonction lambda en Python ?\",\n    code: \"carre = lambda x: x * x\",\n    options: [\n      \"Une fonction asynchrone pour multithreading\",\n      \"Une fonction anonyme restreinte \303\240 une seule expression\",\n      \"Une fonction int\303\251gr\303\251e exclusivement au module math\",\n      \"Une fonction sans argument d\'entr\303\251e\"\n    ],\n    correctIndex: 1,\n    explanation: \"Une fonction lambda est une petite fonction anonyme d\303\251finie en une seule ligne qui renvoie implicitement le r\303\251sultat de son expression unique.\"\n  },\n  {\n    id: 24,\n    level: \'intermediaire\',\n    category: \'Fonctions\',\n    relatedCardId: 8,\n    question: \"Que retourne ce code combinant filter() et list() ?\",\n    code: \"L = [10, 15, 20, 25]\\nres = list(filter(lambda x: x >= 20, L))\\nprint(res)\",\n    options: [\n      \"[True, True]\",\n      \"[20, 25]\",\n      \"[10, 15]\",\n      \"[10, 15, 20, 25]\"\n    ],\n    correctIndex: 1,\n    explanation: \"filter(predicat, iterable) ne conserve que les \303\251l\303\251ments pour lesquels la condition renvoie True (ici 20 et 25).\"\n  },\n  {\n    id: 25,\n    level: \'intermediaire\',\n    category: \'POO\',\n    relatedCardId: 10,\n    question: \"Dans un bloc try / except / else / finally, quand le bloc else s\'ex\303\251cute-t-il ?\",\n    code: \"try:\\n    calcul()\\nexcept ValueError:\\n    print(\'Erreur\')\\nelse:\\n    print(\'Succ\303\250s\')\\nfinally:\\n    print(\'Termin\303\251\')\",\n    options: [\n      \"Uniquement si une exception a \303\251t\303\251 lev\303\251e\",\n      \"Uniquement si aucune exception n\'a \303\251t\303\251 lev\303\251e dans le try\",\n      \"Toujours, juste avant le finally\",\n      \"Uniquement si le code l\303\250ve une autre erreur que ValueError\"\n    ],\n    correctIndex: 1,\n    explanation: \"La clause \'else\' d\'un bloc try s\'ex\303\251cute UNIQUEMENT si le bloc try s\'est achev\303\251 sans lever la moindre exception.\"\n  },\n  {\n    id: 26,\n    level: \'intermediaire\',\n    category: \'Fichiers\',\n    relatedCardId: 13,\n    question: \"Quel est le b\303\251n\303\251fice principal de l\'instruction with open(...) as f: ?\",\n    code: \"with open(\'data.txt\', \'r\') as f:\\n    contenu = f.read()\",\n    options: [\n      \"Elle lit le fichier deux fois plus vite en m\303\251moire\",\n      \"Elle garantit la fermeture automatique du fichier, m\303\252me en cas d\'erreur\",\n      \"Elle chiffre automatiquement le contenu du fichier\",\n      \"Elle emp\303\252che d\'autres programmes de lire le fichier\"\n    ],\n    correctIndex: 1,\n    explanation: \"Le context manager \'with\' garantit l\'appel de f.close() d\303\250s la sortie du bloc, m\303\252me si une exception survient.\"\n  },\n  {\n    id: 27,\n    level: \'intermediaire\',\n    category: \'Fonctions\',\n    relatedCardId: 8,\n    question: \"Que fait le code suivant avec sorted() et l\'argument key ?\",\n    code: \"personnes = [(\'Alice\', 25), (\'Bob\', 19), (\'Charlie\', 30)]\\nsorted(personnes, key=lambda x: x[1])\",\n    options: [\n      \"Trie les personnes par ordre alphab\303\251tique de leur nom\",\n      \"Trie les personnes par ordre croissant de leur \303\242ge (2\303\250me \303\251l\303\251ment)\",\n      \"Supprime les personnes de moins de 25 ans\",\n      \"Inverse les tuples (\303\242ge, nom)\"\n    ],\n    correctIndex: 1,\n    explanation: \"key=lambda x: x[1] extrait le second \303\251l\303\251ment (l\'\303\242ge) comme crit\303\250re de tri pour chaque tuple.\"\n  },\n  {\n    id: 28,\n    level: \'intermediaire\',\n    category: \'Fichiers\',\n    relatedCardId: 12,\n    question: \"Quelle fonction du module os.path permet de s\303\251parer le nom du fichier et son extension ?\",\n    options: [\n      \"os.path.splitfile(nom)\",\n      \"os.path.splitext(nom)\",\n      \"os.path.extension(nom)\",\n      \"os.path.basename(nom)\"\n    ],\n    correctIndex: 1,\n    explanation: \"os.path.splitext(\'rapport.pdf\') retourne (\'rapport\', \'.pdf\'). L\'extension se trouve \303\240 l\'index [1].\"\n  },\n  {\n    id: 29,\n    level: \'intermediaire\',\n    category: \'Donn\303\251es\',\n    relatedCardId: 6,\n    question: \"Quelle m\303\251thode permet d\'it\303\251rer simultan\303\251ment sur les cl\303\251s et valeurs d\'un dictionnaire ?\",\n    code: \"for k, v in d.???():\\n    print(k, v)\",\n    options: [\n      \"pairs()\",\n      \"items()\",\n      \"entries()\",\n      \"all()\"\n    ],\n    correctIndex: 1,\n    explanation: \"d.items() renvoie une vue de tuples (cl\303\251, valeur) permettant de d\303\251baller directement k et v dans la boucle for.\"\n  },\n  {\n    id: 30,\n    level: \'intermediaire\',\n    category: \'Fonctions\',\n    relatedCardId: 7,\n    question: \"Que repr\303\251sentent les annotations comme \'def f(x: int) -> int:\' en Python 3 ?\",\n    options: [\n      \"Des contraintes impos\303\251es \303\240 l\'ex\303\251cution qui l\303\250vent une TypeError si viol\303\251es\",\n      \"Des indications de type (Type Hints) pour la documentation et les analyseurs de code\",\n      \"Une syntaxe de conversion automatique des arguments\",\n      \"Des directives pour le ramasse-miettes\"\n    ],\n    correctIndex: 1,\n    explanation: \"Les Type Hints aident les d\303\251veloppeurs et outils statiques (comme mypy) mais Python ne force pas les types au runtime.\"\n  },\n  {\n    id: 31,\n    level: \'intermediaire\',\n    category: \'Fichiers\',\n    relatedCardId: 13,\n    question: \"Quelle est la diff\303\251rence entre les modes \'w\' et \'a\' de la fonction open() ?\",\n    options: [\n      \"\'w\' \303\251crit en binaire, \'a\' \303\251crit en texte ASCII\",\n      \"\'w\' \303\251crase le fichier existant, \'a\' ajoute le texte \303\240 la fin du fichier\",\n      \"\'w\' permet la lecture et l\'\303\251criture, \'a\' est en lecture seule\",\n      \"\'w\' est asynchrone, \'a\' est bloquant\"\n    ],\n    correctIndex: 1,\n    explanation: \"Le mode \'w\' (write) tronque et \303\251crase le fichier. Le mode \'a\' (append) ajoute le contenu \303\240 la fin sans \303\251craser.\"\n  },\n  {\n    id: 32,\n    level: \'intermediaire\',\n    category: \'Fonctions\',\n    relatedCardId: 8,\n    question: \"Que retourne l\'application de map() suivante ?\",\n    code: \"L = [1, 2, 3]\\nres = list(map(lambda x: x * 2, L))\",\n    options: [\n      \"[1, 2, 3, 1, 2, 3]\",\n      \"[2, 4, 6]\",\n      \"[2, 2, 2]\",\n      \"Une erreur TypeError\"\n    ],\n    correctIndex: 1,\n    explanation: \"map() applique la fonction \303\240 chaque \303\251l\303\251ment de la liste L, produisant [1*2, 2*2, 3*2] = [2, 4, 6].\"\n  },\n  {\n    id: 33,\n    level: \'intermediaire\',\n    category: \'POO\',\n    relatedCardId: 10,\n    question: \"Quel mot-cl\303\251 est utilis\303\251 pour d\303\251clencher d\303\251lib\303\251r\303\251ment une exception en Python ?\",\n    code: \"if age < 0:\\n    ??? ValueError(\\\"\303\202ge invalide\\\")\",\n    options: [\n      \"throw\",\n      \"raise\",\n      \"fire\",\n      \"dispatch\"\n    ],\n    correctIndex: 1,\n    explanation: \"En Python, on utilise le mot-cl\303\251 \'raise\' pour lever une exception (contrairement \303\240 \'throw\' en JavaScript ou Java).\"\n  },\n  {\n    id: 34,\n    level: \'intermediaire\',\n    category: \'Fichiers\',\n    relatedCardId: 12,\n    question: \"Quelle fonction permet de supprimer un fichier du disque via le module os ?\",\n    options: [\n      \"os.delete(fichier)\",\n      \"os.remove(fichier)\",\n      \"os.unlink_file(fichier)\",\n      \"os.rm(fichier)\"\n    ],\n    correctIndex: 1,\n    explanation: \"os.remove(chemin) ou os.unlink(chemin) supprime un fichier du syst\303\250me.\"\n  },\n  {\n    id: 35,\n    level: \'intermediaire\',\n    category: \'Fichiers\',\n    relatedCardId: 13,\n    question: \"Que retourne la m\303\251thode f.readlines() sur un fichier ouvert en lecture ?\",\n    options: [\n      \"Une seule cha\303\256ne de caract\303\250res avec tout le fichier\",\n      \"Une liste de cha\303\256nes, o\303\271 chaque \303\251l\303\251ment correspond \303\240 une ligne\",\n      \"Le nombre total de lignes sous forme d\'entier\",\n      \"Un g\303\251n\303\251rateur d\'octets\"\n    ],\n    correctIndex: 1,\n    explanation: \"f.readlines() lit tout le fichier et renvoie une liste de cha\303\256nes contenant chaque ligne (avec son retour \303\240 la ligne \'\\\\n\').\"\n  },\n  {\n    id: 36,\n    level: \'intermediaire\',\n    category: \'Fichiers\',\n    relatedCardId: 12,\n    question: \"Quel module de la biblioth\303\250que standard fournit la fonction copyfile(src, dst) ?\",\n    options: [\n      \"os\",\n      \"sys\",\n      \"shutil\",\n      \"pathlib\"\n    ],\n    correctIndex: 2,\n    explanation: \"Le module shutil (shell utilities) offre des fonctions de haut niveau pour copier et d\303\251placer des fichiers et dossiers.\"\n  },\n  {\n    id: 37,\n    level: \'intermediaire\',\n    category: \'Donn\303\251es\',\n    relatedCardId: 5,\n    question: \"Que vaut la liste r\303\251sultant de cette compr\303\251hension de liste ?\",\n    code: \"carres_pairs = [x**2 for x in [1, 2, 3, 4] if x % 2 == 0]\",\n    options: [\n      \"[1, 4, 9, 16]\",\n      \"[4, 16]\",\n      \"[2, 4]\",\n      \"[1, 9]\"\n    ],\n    correctIndex: 1,\n    explanation: \"La condition filtre les pairs (2 et 4), puis calcule leurs carr\303\251s : 2**2 = 4 et 4**2 = 16.\"\n  },\n  {\n    id: 38,\n    level: \'intermediaire\',\n    category: \'Donn\303\251es\',\n    relatedCardId: 6,\n    question: \"Que retourne l\'appel d.keys() sur un dictionnaire Python 3 ?\",\n    options: [\n      \"Une copie de la liste des cl\303\251s\",\n      \"Une vue dynamique it\303\251rable des cl\303\251s du dictionnaire (dict_keys)\",\n      \"Un tuple immuable\",\n      \"Le premier \303\251l\303\251ment du dictionnaire\"\n    ],\n    correctIndex: 1,\n    explanation: \"d.keys() renvoie un objet vue \'dict_keys\' qui refl\303\250te les modifications du dictionnaire en temps r\303\251el sans dupliquer la m\303\251moire.\"\n  },\n  {\n    id: 39,\n    level: \'intermediaire\',\n    category: \'Fichiers\',\n    relatedCardId: 12,\n    question: \"Comment v\303\251rifier si un chemin correspond \303\240 un dossier existant avec le module os ?\",\n    options: [\n      \"os.path.isdir(chemin)\",\n      \"os.path.isfolder(chemin)\",\n      \"os.path.directory(chemin)\",\n      \"os.is_dir(chemin)\"\n    ],\n    correctIndex: 0,\n    explanation: \"os.path.isdir(chemin) renvoie True si le chemin existe et est un r\303\251pertoire. Pour un fichier, c\'est os.path.isfile(chemin).\"\n  },\n  {\n    id: 40,\n    level: \'intermediaire\',\n    category: \'POO\',\n    relatedCardId: 10,\n    question: \"Dans un bloc try/except, quel bloc est garanti d\'\303\252tre TOUJOURS ex\303\251cut\303\251 ?\",\n    code: \"try:\\n    ...\\nfinally:\\n    # Ce bloc...\",\n    options: [\n      \"else\",\n      \"finally\",\n      \"except\",\n      \"catch\"\n    ],\n    correctIndex: 1,\n    explanation: \"Le bloc \'finally\' est toujours ex\303\251cut\303\251, qu\'une exception ait \303\251t\303\251 lev\303\251e, intercept\303\251e ou non, ce qui le rend id\303\251al pour le nettoyage.\"\n  },\n\n  // ==========================================\n  // --- NIVEAU AVANC\303\211 (20 QUESTIONS) ---\n  // ==========================================\n  {\n    id: 41,\n    level: \'avance\',\n    category: \'POO\',\n    relatedCardId: 9,\n    question: \"Pourquoi le premier param\303\250tre d\'une m\303\251thode d\'instance est-il traditionnellement nomm\303\251 self ?\",\n    code: \"class Robot:\\n    def bip(self):\\n        print(\'Bip !\')\",\n    options: [\n      \"C\'est un mot-cl\303\251 r\303\251serv\303\251 obligatoire impos\303\251 par la syntaxe\",\n      \"Il repr\303\251sente la r\303\251f\303\251rence explicite \303\240 l\'instance courante de l\'objet\",\n      \"Il sert \303\240 d\303\251clarer la m\303\251thode comme \303\251tant priv\303\251e\",\n      \"Il indique que la classe est statique\"\n    ],\n    correctIndex: 1,\n    explanation: \"En Python, self repr\303\251sente l\'instance de l\'objet. Python lui passe automatiquement l\'objet appelant en premier argument.\"\n  },\n  {\n    id: 42,\n    level: \'avance\',\n    category: \'Architecture\',\n    relatedCardId: 11,\n    question: \"Quel est le r\303\264le exact de la condition if __name__ == \'__main__\': ?\",\n    code: \"if __name__ == \'__main__\':\\n    demarrer_application()\",\n    options: [\n      \"V\303\251rifier que le script s\'ex\303\251cute avec les privil\303\250ges root/administrateur\",\n      \"Ex\303\251cuter ce bloc uniquement si le fichier est lanc\303\251 directement, et non import\303\251 comme module\",\n      \"Indiquer au ramasse-miettes que le script est le point central\",\n      \"Forcer la compilation en bytecode .pyc\"\n    ],\n    correctIndex: 1,\n    explanation: \"Quand un script est ex\303\251cut\303\251 directement, sa variable __name__ prend la valeur \'__main__\'. S\'il est import\303\251, elle prend le nom du fichier module.\"\n  },\n  {\n    id: 43,\n    level: \'avance\',\n    category: \'Data Science\',\n    relatedCardId: 14,\n    question: \"Dans NumPy, que produit l\'op\303\251ration de masquage bool\303\251en t[t % 2 == 0] ?\",\n    code: \"import numpy as np\\nt = np.array([1, 2, 3, 4, 5, 6])\\nres = t[t % 2 == 0]\",\n    options: [\n      \"Un tableau de bool\303\251ens [False, True, False, True, False, True]\",\n      \"Un sous-tableau contenant uniquement les nombres pairs [2, 4, 6]\",\n      \"Une erreur car les op\303\251rations modulo ne sont pas vectoris\303\251es\",\n      \"Le tableau d\'origine inchang\303\251\"\n    ],\n    correctIndex: 1,\n    explanation: \"t % 2 == 0 g\303\251n\303\250re un masque bool\303\251en vectoris\303\251. Index\303\251 dans t[...], NumPy extrait les valeurs o\303\271 la condition est True : [2, 4, 6].\"\n  },\n  {\n    id: 44,\n    level: \'avance\',\n    category: \'Data Science\',\n    relatedCardId: 15,\n    question: \"Dans Pandas, quelle est la diff\303\251rence majeure entre df.loc[] et df.iloc[] ?\",\n    code: \"df.loc[2]\\ndf.iloc[2]\",\n    options: [\n      \"loc utilise les labels/noms d\'index, alors qu\'iloc utilise les positions enti\303\250res (0, 1, 2...)\",\n      \"loc est pour les colonnes et iloc est pour les lignes\",\n      \"loc modifie les valeurs et iloc les lit uniquement\",\n      \"iloc est d\303\251pr\303\251ci\303\251 depuis Pandas 2.0\"\n    ],\n    correctIndex: 0,\n    explanation: \"loc[] filtre selon les labels d\'index. iloc[] (integer location) filtre strictement selon la position num\303\251rique (index base 0).\"\n  },\n  {\n    id: 45,\n    level: \'avance\',\n    category: \'Fonctions\',\n    relatedCardId: 8,\n    question: \"Que retourne functools.reduce appliqu\303\251 \303\240 une liste d\'entiers avec une addition ?\",\n    code: \"from functools import reduce\\nL = [1, 2, 3, 4]\\nval = reduce(lambda a, x: a + x, L, 0)\\nprint(val)\",\n    options: [\n      \"10 (la somme cumul\303\251e de tous les \303\251l\303\251ments)\",\n      \"[1, 3, 6, 10] (une liste des sommes partielles)\",\n      \"0 (la valeur initiale)\",\n      \"Une erreur TypeError car reduce n\303\251cessite deux listes\"\n    ],\n    correctIndex: 0,\n    explanation: \"reduce applique successivement la fonction binaire \303\240 l\'accumulateur et \303\240 chaque \303\251l\303\251ment, r\303\251duisant la collection \303\240 une seule valeur finale (ici 10).\"\n  },\n  {\n    id: 46,\n    level: \'avance\',\n    category: \'POO\',\n    relatedCardId: 9,\n    question: \"Quel est le nom de la m\303\251thode sp\303\251ciale constructeur/initialiseur appel\303\251e lors de la cr\303\251ation d\'un objet ?\",\n    options: [\n      \"__construct__\",\n      \"__init__\",\n      \"__new__\",\n      \"__create__\"\n    ],\n    correctIndex: 1,\n    explanation: \"La m\303\251thode __init__(self, ...) est l\'initialiseur standard appel\303\251 imm\303\251diatement apr\303\250s l\'instanciation d\'un nouvel objet.\"\n  },\n  {\n    id: 47,\n    level: \'avance\',\n    category: \'Data Science\',\n    relatedCardId: 14,\n    question: \"Que fait la m\303\251thode reshape(2, 3) sur un tableau NumPy \303\240 6 \303\251l\303\251ments ?\",\n    code: \"t = np.arange(1, 7) # [1, 2, 3, 4, 5, 6]\\nt.reshape(2, 3)\",\n    options: [\n      \"Multiplie le tableau par 2 puis par 3\",\n      \"R\303\251organise le tableau en 2 lignes et 3 colonnes sans copier les donn\303\251es\",\n      \"Tronque le tableau pour ne garder que 2 \303\251l\303\251ments\",\n      \"Cr\303\251e un tuple de 6 dimensions\"\n    ],\n    correctIndex: 1,\n    explanation: \"reshape(lignes, colonnes) change les dimensions du tenseur/matrice sans modifier les donn\303\251es sous-jacentes, \303\240 condition que le nombre total d\'\303\251l\303\251ments corresponde.\"\n  },\n  {\n    id: 48,\n    level: \'avance\',\n    category: \'Data Science\',\n    relatedCardId: 14,\n    question: \"Quelle fonction NumPy g\303\251n\303\250re un tableau de z\303\251ros flottants de taille N ?\",\n    options: [\n      \"np.empty_zeros(5)\",\n      \"np.zeros(5)\",\n      \"np.null(5)\",\n      \"np.create_zeros(5)\"\n    ],\n    correctIndex: 1,\n    explanation: \"np.zeros(taille) cr\303\251e un tableau rempli de z\303\251ros (type float64 par d\303\251faut).\"\n  },\n  {\n    id: 49,\n    level: \'avance\',\n    category: \'Data Science\',\n    relatedCardId: 15,\n    question: \"Comment filtrer conditionnellement les lignes d\'un DataFrame df o\303\271 la colonne \'X\' est sup\303\251rieure ou \303\251gale \303\240 20 ?\",\n    options: [\n      \"df.filter(X >= 20)\",\n      \"df.loc[df[\'X\'] >= 20]\",\n      \"df.where(\'X >= 20\')\",\n      \"df.select(df.X > 20)\"\n    ],\n    correctIndex: 1,\n    explanation: \"df.loc[df[\'X\'] >= 20] ou df[df[\'X\'] >= 20] utilise un masque bool\303\251en sur la s\303\251rie pour extraire les lignes correspondantes.\"\n  },\n  {\n    id: 50,\n    level: \'avance\',\n    category: \'Data Science\',\n    relatedCardId: 16,\n    question: \"Dans Matplotlib, quelle fonction permet de tracer un nuage de points ?\",\n    options: [\n      \"plt.plot()\",\n      \"plt.scatter()\",\n      \"plt.points()\",\n      \"plt.dots()\"\n    ],\n    correctIndex: 1,\n    explanation: \"plt.scatter(x, y) est la fonction d\303\251di\303\251e aux nuages de points (scatter plot). plt.plot() trace des lignes reliant les points.\"\n  },\n  {\n    id: 51,\n    level: \'avance\',\n    category: \'Data Science\',\n    relatedCardId: 16,\n    question: \"Quelle commande Matplotlib affiche enfin la figure rendue \303\240 l\'\303\251cran ?\",\n    options: [\n      \"plt.render()\",\n      \"plt.draw_now()\",\n      \"plt.show()\",\n      \"plt.display()\"\n    ],\n    correctIndex: 2,\n    explanation: \"plt.show() d\303\251clenche l\'affichage effectif de toutes les figures configur\303\251es.\"\n  },\n  {\n    id: 52,\n    level: \'avance\',\n    category: \'Architecture\',\n    relatedCardId: 11,\n    question: \"Quelle est la syntaxe correcte pour importer une fonction sp\303\251cifique depuis un module ?\",\n    options: [\n      \"from module import ma_fonction\",\n      \"import ma_fonction of module\",\n      \"using module.ma_fonction\",\n      \"require module(ma_fonction)\"\n    ],\n    correctIndex: 0,\n    explanation: \"La syntaxe \'from module import nom\' permet d\'importer directement un symbole dans le namespace local.\"\n  },\n  {\n    id: 53,\n    level: \'avance\',\n    category: \'Data Science\',\n    relatedCardId: 16,\n    question: \"Quelle fonction Matplotlib permet d\'afficher la l\303\251gende des courbes ?\",\n    options: [\n      \"plt.legend()\",\n      \"plt.labels()\",\n      \"plt.guide()\",\n      \"plt.caption()\"\n    ],\n    correctIndex: 0,\n    explanation: \"plt.legend() place la bo\303\256te de l\303\251gende sur le graphique en utilisant les arguments label=\'...\' des trac\303\251s.\"\n  },\n  {\n    id: 54,\n    level: \'avance\',\n    category: \'Data Science\',\n    relatedCardId: 15,\n    question: \"Comment s\303\251lectionner une sous-table avec toutes les lignes et uniquement les colonnes \'X\' et \'Y\' dans un DataFrame ?\",\n    options: [\n      \"df.loc[:, [\'X\', \'Y\']]\",\n      \"df.cols([\'X\', \'Y\'])\",\n      \"df.extract(\'X\', \'Y\')\",\n      \"df.get_columns(\'X\', \'Y\')\"\n    ],\n    correctIndex: 0,\n    explanation: \"df.loc[lignes, colonnes] utilise \':\' pour toutes les lignes et la liste [\'X\', \'Y\'] pour les colonnes.\"\n  },\n  {\n    id: 55,\n    level: \'avance\',\n    category: \'POO\',\n    relatedCardId: 9,\n    question: \"Comment instancier une classe Personne prenant deux arguments nom et age ?\",\n    code: \"class Personne:\\n    def __init__(self, nom, age):\\n        self.nom = nom\\n        self.age = age\",\n    options: [\n      \"p = new Personne(\\\"Bob\\\", 31)\",\n      \"p = Personne(\\\"Bob\\\", 31)\",\n      \"p = Personne.create(\\\"Bob\\\", 31)\",\n      \"p = Personne.init(\\\"Bob\\\", 31)\"\n    ],\n    correctIndex: 1,\n    explanation: \"En Python, on appelle simplement le nom de la classe comme une fonction : Personne(\'Bob\', 31). Le mot-cl\303\251 \'new\' n\'existe pas.\"\n  },\n  {\n    id: 56,\n    level: \'avance\',\n    category: \'Data Science\',\n    relatedCardId: 14,\n    question: \"Quelle est la propri\303\251t\303\251 d\'un tableau NumPy qui renvoie ses dimensions sous forme de tuple ?\",\n    code: \"t = np.zeros((3, 4))\",\n    options: [\n      \"t.size\",\n      \"t.shape\",\n      \"t.dim\",\n      \"t.length\"\n    ],\n    correctIndex: 1,\n    explanation: \"t.shape renvoie un tuple indiquant la taille de chaque axe (ici (3, 4)). t.size renvoie le nombre total d\'\303\251l\303\251ments (12).\"\n  },\n  {\n    id: 57,\n    level: \'avance\',\n    category: \'Data Science\',\n    relatedCardId: 14,\n    question: \"Quelle est la principale diff\303\251rence entre np.arange(1, 6) et la fonction native range(1, 6) ?\",\n    options: [\n      \"np.arange inclut la borne sup\303\251rieure\",\n      \"np.arange renvoie directement un ndarray NumPy vectorisable et accepte des pas d\303\251cimaux (float)\",\n      \"range() est plus rapide pour le calcul vectoriel\",\n      \"np.arange ne fonctionne qu\'avec des cha\303\256nes de caract\303\250res\"\n    ],\n    correctIndex: 1,\n    explanation: \"np.arange() cr\303\251e un tableau NumPy de donn\303\251es contigu\303\253s en m\303\251moire et supporte les pas flottants (ex: 0.1), contrairement \303\240 range() natif.\"\n  },\n  {\n    id: 58,\n    level: \'avance\',\n    category: \'Data Science\',\n    relatedCardId: 16,\n    question: \"Quelle fonction Matplotlib permet de g\303\251n\303\251rer un diagramme en barres ?\",\n    options: [\n      \"plt.column()\",\n      \"plt.bar()\",\n      \"plt.hist_bars()\",\n      \"plt.stick()\"\n    ],\n    correctIndex: 1,\n    explanation: \"plt.bar(categories, hauteurs) trace des rectangles verticaux pour chaque cat\303\251gorie.\"\n  },\n  {\n    id: 59,\n    level: \'avance\',\n    category: \'Data Science\',\n    relatedCardId: 16,\n    question: \"Quelle fonction Matplotlib trace un diagramme circulaire (camembert) ?\",\n    options: [\n      \"plt.donut()\",\n      \"plt.circle()\",\n      \"plt.pie()\",\n      \"plt.round()\"\n    ],\n    correctIndex: 2,\n    explanation: \"plt.pie(valeurs, labels=labels) cr\303\251e un diagramme circulaire.\"\n  },\n  {\n    id: 60,\n    level: \'avance\',\n    category: \'Fichiers\',\n    relatedCardId: 12,\n    question: \"Quelle fonction du module os permet de renommer ou d\303\251placer un fichier d\'un chemin source (src) vers une destination (dst) ?\",\n    options: [\n      \"os.move_file(src, dst)\",\n      \"os.rename(src, dst)\",\n      \"os.transfer(src, dst)\",\n      \"os.alter(src, dst)\"\n    ],\n    correctIndex: 1,\n    explanation: \"os.rename(src, dst) renomme ou d\303\251place un fichier sur le m\303\252me syst\303\250me de fichiers.\"\n  }\n];\n\nexport const LEVEL_METADATA = {\n  debutant: {\n    id: \'debutant\' as const,\n    name: \'D\303\251butant\',\n    label: \'Bases & Fondamentaux\',\n    description: \'Variables, types, input/print, boucles, conditions, listes \303\251l\303\251mentaires & d\303\251ballage.\',\n    color: \'emerald\',\n    badgeClass: \'bg-emerald-50 text-emerald-700 border-emerald-200\',\n    iconColor: \'text-emerald-500\',\n    dotColor: \'bg-emerald-500\',\n  },\n  intermediaire: {\n    id: \'intermediaire\' as const,\n    name: \'Interm\303\251diaire\',\n    label: \'Structures & Fonctions\',\n    description: \'Dictionnaires (.get, items), slicing avanc\303\251, lambdas, map/filter, exceptions & fichiers.\',\n    color: \'amber\',\n    badgeClass: \'bg-amber-50 text-amber-800 border-amber-200\',\n    iconColor: \'text-amber-500\',\n    dotColor: \'bg-amber-500\',\n  },\n  avance: {\n    id: \'avance\' as const,\n    name: \'Avanc\303\251\',\n    label: \'POO, Architecture & Data Science\',\n    description: \'Classes, self, __name__, context managers, NumPy vectoriel, Pandas & Matplotlib.\',\n    color: \'purple\',\n    badgeClass: \'bg-purple-50 text-purple-700 border-purple-200\',\n    iconColor: \'text-purple-500\',\n    dotColor: \'bg-purple-500\',\n  },\n  tous: {\n    id: \'tous\' as const,\n    name: \'Tous niveaux\',\n    label: \'Grand D\303\251fi Complet (60 Questions)\',\n    description: \'L\342\200\231ensemble des 60 notions m\303\251lang\303\251es pour une ma\303\256trise totale du langage Python.\',\n    color: \'blue\',\n    badgeClass: \'bg-blue-50 text-blue-700 border-blue-200\',\n    iconColor: \'text-blue-500\',\n    dotColor: \'bg-blue-500\',\n  },\n};\n"
