        lines {
          text: "    code: \"try:\\n    calcul()\\nexcept ValueError:\\n    print(\'Erreur\')\\nelse:\\n    print(\'Succ\303\250s\')\\nfinally:\\n    print(\'Termin\303\251\')\","
