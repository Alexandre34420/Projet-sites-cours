      arguments_json: "{\"Content\":\"export interface CheatSheetItem {\\n  id: number;\\n  category: string;\\n  title: string;\\n  code: string;\\n  description?: string;\\n  tags?: string[];\\n}\\n\\nexport const CHEAT_SHEET_DATA: CheatSheetItem[] = [\\n  {\\n    \\\"id\\\": 1,\\n    \\\"category\\\": \\\"Bases\\\",\\n    \\\"title\\\": \\\"Entr\303\251es / Sorties\\\",\\n    \\\"code\\\": \\\"print(a, b, sep=\\\\\\\" \\\\\\\", end=\\\\\\\"\\\\\\\\n\\\\\\\")\\\\n\\\\n# Saisie utilisateur\\\\ns = input(\\\\\\\"Texte : \\\\\\\")\\\\nx = int(input(\\\\\\\"Entier : \\\\\\\"))\\\"\\n  },\\n  {\\n    \\\"id\\\": 2,\\n    \\\"category\\\": \\\"Bases\\\",\\n    \\\"title\\\": \\\"Boucles & Conditions\\\",\\n    \\\"code\\\": \\\"if condition:\\\\n    ...\\\\nelif autre_condition:\\\\n    ...\\\\nelse:\\\\n    ...\\\\n\\\\nwhile condition:\\\\n    ...\\\\n\\\\nfor i in range(debut, fin, pas):\\\\n    ...\\\\n\\\\nfor element in sequence:\\\\n    ...\\\"\\n  },\\n  {\\n    \\\"id\\\": 3,\\n    \\\"category\\\": \\\"Bases\\\",\\n    \\\"title\\\": \\\"Types & Conversions\\\",\\n    \\\"code\\\": \\\"int(x)    # Conversion en entier\\\\nfloat(x)  # Conversion en d\303\251cimal\\\\nstr(x)    # Conversion en cha\303\256ne\\\\nbool(x)   # Conversion en bool\303\251en\\\"\\n  },\\n  {\\n    \\\"id\\\": 4,\\n    \\\"category\\\": \\\"Donn\303\251es\\\",\\n    \\\"title\\\": \\\"Tuples (Immuables)\\\",\\n    \\\"code\\\": \\\"t = (12, 18)\\\\nx, y = t # D\303\251paquetage\\\"\\n  },\\n  {\\n    \\\"id\\\": 5,\\n    \\\"category\\\": \\\"Donn\303\251es\\\",\\n    \\\"title\\\": \\\"Listes (Mutables)\\\",\\n    \\\"code\\\": \\\"L = [1, 2, 3]\\\\nL.append(4)      # Ajouter\\\\ndel L[0]         # Supprimer par index\\\\nL.remove(2)      # Supprimer par valeur\\\\n\\\\n# Slicing\\\\nL[2:4]           # De l\'index 2 \303\240 3\\\\nL[::-1]          # Inverser la liste\\\\n\\\\nlen(L)           # Taille de la liste\\\"\\n  },\\n  {\\n    \\\"id\\\": 6,\\n    \\\"category\\\": \\\"Donn\303\251es\\\",\\n    \\\"title\\\": \\\"Dictionnaires\\\",\\n    \\\"code\\\": \\\"d = {\'a\': 1, \'b\': 2}\\\\nd[\'a\'] = 3\\\\n\\\\nfor k, v in d.items():\\\\n    print(k, v)\\\\n\\\\nd.keys()   # Liste des cl\303\251s\\\\nd.values() # Liste des valeurs\\\"\\n  },\\n  {\\n    \\\"id\\\": 7,\\n    \\\"category\\\": \\\"Fonctions\\\",\\n    \\\"title\\\": \\\"Fonctions & Type Hints\\\",\\n    \\\"code\\\": \\\"def f(x: int) -> int:\\\\n    return x + 1\\\\n\\\\n# Fonction anonyme (Lambda)\\\\nf = lambda x: x * x\\\"\\n  },\\n  {\\n    \\\"id\\\": 8,\\n    \\\"category\\\": \\\"Fonctions\\\",\\n    \\\"title\\\": \\\"Map / Filter / Reduce\\\",\\n    \\\"code\\\": \\\"list(map(lambda x: x * x, L))\\\\n\\\\nlist(filter(lambda x: x >= 18, L))\\\\n\\\\nfrom functools import reduce\\\\nreduce(lambda a, x: a + x, L, 0)\\\\n\\\\n# Tri avec cl\303\251\\\\nsorted(liste, key=lambda x: x[1])\\\"\\n  },\\n  {\\n    \\\"id\\\": 9,\\n    \\\"category\\\": \\\"POO\\\",\\n    \\\"title\\\": \\\"Classes & Objets\\\",\\n    \\\"code\\\": \\\"class Personne:\\\\n    # Constructeur\\\\n    def __init__(self, nom, age):\\\\n        self.nom = nom\\\\n        self.age = age\\\\n        \\\\n    # M\303\251thode d\'instance\\\\n    def bonjour(self):\\\\n        print(\\\\\\\"Salut\\\\\\\", self.nom)\\\\n\\\\np = Personne(\\\\\\\"Bob\\\\\\\", 31)\\\\np.bonjour()\\\"\\n  },\\n  {\\n    \\\"id\\\": 10,\\n    \\\"category\\\": \\\"POO\\\",\\n    \\\"title\\\": \\\"Exceptions\\\",\\n    \\\"code\\\": \\\"try:\\\\n    ...\\\\nexcept ValueError:\\\\n    print(\\\\\\\"Erreur de valeur\\\\\\\")\\\\nexcept:\\\\n    print(\\\\\\\"Autre erreur\\\\\\\")\\\\nelse:\\\\n    print(\\\\\\\"Aucune erreur\\\\\\\")\\\\nfinally:\\\\n    print(\\\\\\\"Toujours ex\303\251cut\303\251\\\\\\\")\\\\n\\\\nraise ValueError(\\\\\\\"Message d\'erreur\\\\\\\")\\\"\\n  },\\n  {\\n    \\\"id\\\": 11,\\n    \\\"category\\\": \\\"Architecture\\\",\\n    \\\"title\\\": \\\"Modules & Packages\\\",\\n    \\\"code\\\": \\\"import utils\\\\nfrom utils import ma_fonction\\\\n\\\\n# Point d\'entr\303\251e du programme\\\\nif __name__ == \'__main__\':\\\\n    print(\\\\\\\"Script principal\\\\\\\")\\\"\\n  },\\n  {\\n    \\\"id\\\": 12,\\n    \\\"category\\\": \\\"Fichiers\\\",\\n    \\\"title\\\": \\\"Module OS & Shutil\\\",\\n    \\\"code\\\": \\\"import os, shutil\\\\n\\\\nos.path.isfile(chemin)\\\\nos.path.isdir(chemin)\\\\nos.path.splitext(nom)[1] # Extension\\\\n\\\\nos.rename(src, dst)\\\\nos.remove(fichier)\\\\n\\\\nshutil.copyfile(src, dst)\\\"\\n  },\\n  {\\n    \\\"id\\\": 13,\\n    \\\"category\\\": \\\"Fichiers\\\",\\n    \\\"title\\\": \\\"Lecture & \303\211criture\\\",\\n    \\\"code\\\": \\\"with open(\\\\\\\"file.txt\\\\\\\", \\\\\\\"r\\\\\\\") as f:\\\\n    contenu = f.read()\\\\n    lignes = f.readlines()\\\\n\\\\nwith open(\\\\\\\"file.txt\\\\\\\", \\\\\\\"w\\\\\\\") as f:\\\\n    f.write(\\\\\\\"\303\251crase et \303\251crit\\\\\\\")\\\\n\\\\nwith open(\\\\\\\"file.txt\\\\\\\", \\\\\\\"a\\\\\\\") as f:\\\\n    f.write(\\\\\\\"ajoute \303\240 la fin\\\\\\\")\\\"\\n  },\\n  {\\n    \\\"id\\\": 14,\\n    \\\"category\\\": \\\"Data Science\\\",\\n    \\\"title\\\": \\\"Numpy (Tableaux)\\\",\\n    \\\"code\\\": \\\"import numpy as np\\\\n\\\\nt = np.array([1, 2, 3])\\\\nnp.arange(1, 6)\\\\nnp.zeros(5)\\\\n\\\\nt.reshape(2, 3)\\\\nt.shape\\\\n\\\\n# Masque bool\303\251en\\\\nt[t % 2 == 0]\\\"\\n  },\\n  {\\n    \\\"id\\\": 15,\\n    \\\"category\\\": \\\"Data Science\\\",\\n    \\\"title\\\": \\\"Pandas (DataFrames)\\\",\\n    \\\"code\\\": \\\"import pandas as pd\\\\n\\\\ndf = pd.DataFrame({\'X\': [1, 2], \'Y\': [3, 4]})\\\\n\\\\ndf[\\\\\\\"X\\\\\\\"]                 # Colonne\\\\ndf.loc[2]               # Ligne (index 2)\\\\ndf.loc[:, [\\\\\\\"X\\\\\\\", \\\\\\\"Y\\\\\\\"]]   # Sous-table\\\\n\\\\n# Filtrage conditionnel\\\\ndf.loc[df[\\\\\\\"X\\\\\\\"] >= 20]\\\"\\n  },\\n  {\\n    \\\"id\\\": 16,\\n    \\\"category\\\": \\\"Data Science\\\",\\n    \\\"title\\\": \\\"Matplotlib (Graphiques)\\\",\\n    \\\"code\\\": \\\"import matplotlib.pyplot as plt\\\\n\\\\nplt.plot(x, y)           # Courbe\\\\nplt.scatter(x, y)        # Nuage de points\\\\nplt.bar(items, valeurs)  # Barres\\\\nplt.pie(valeurs, labels=items)\\\\n\\\\nplt.xlabel(\\\\\\\"Axe X\\\\\\\")\\\\nplt.title(\\\\\\\"Titre\\\\\\\")\\\\nplt.legend()\\\\nplt.show()\\\"\\n  }\\n];\\n\", \"Overwrite\":true, \"TargetFile\":\"/src/data.ts\", \"toolAction\":\"Creating data.ts with Python cheat sheet data\", \"toolSummary\":\"Create src/data.ts\"}"
