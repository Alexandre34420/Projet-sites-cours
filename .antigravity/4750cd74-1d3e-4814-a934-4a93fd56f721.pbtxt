          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    explanation: \"La clause \'else\' d\'un bloc try s\'ex\303\251cute UNIQUEMENT si le bloc try s\'est achev\303\251 sans lever la moindre exception.\""
