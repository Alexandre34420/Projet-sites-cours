        lines {
          text: "    question: \"Quelle est la principale diff\303\251rence entre un tuple et une liste ?\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    options: ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \"Les listes s\'\303\251crivent avec des parenth\303\250ses, les tuples avec des crochets\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \"Les tuples sont immuables (non modifiables), les listes sont mutables\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \"Les tuples ne peuvent contenir que des nombres\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \"Les tuples sont toujours tri\303\251s par d\303\251faut\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    correctIndex: 1,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    explanation: \"Les tuples (cr\303\251\303\251s avec des parenth\303\250ses ou virgules) sont immuables : une fois cr\303\251\303\251s, on ne peut ni ajouter ni modifier leurs \303\251l\303\251ments.\""
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
